				cam_clk-supply = <0xffffffff>;
				cam_vdig-supply = <0x9d>;
				cam_vio-supply = <0xffffffff>;
				led-flash-src = <0xfb>;
				eeprom-src = <0xfa>;
				ois-src = <0xf9>;
				actuator-src = <0xf8>;
				sensor-position-yaw = <0xb4>;
				sensor-position-pitch = <0x00>;
				sensor-position-roll = <0x5a>;
				csiphy-sd-index = <0x03>;
				compatible = "qcom,cam-sensor";
				cell-index = <0x03>;
			};
		};
	};

	fragment@98 {
		target = <0xffffffff>;

		__overlay__ {

			bt_en_sleep {
